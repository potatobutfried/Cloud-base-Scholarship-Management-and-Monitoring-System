rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin or reviewer
    function isAdminOrReviewer() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['administrator', 'reviewer'];
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    }
    
    // Users collection - allow user creation and self-access
    match /users/{userId} {
      // Allow user creation during signup (both authenticated and anonymous)
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users can read/write their own data
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Admins can read all users
      allow read: if isAdmin();
      // Admins can update user roles
      allow update: if isAdmin();
    }
    
    // Scholarship applications - support both authenticated and guest submissions
    match /scholarship_applications/{applicationId} {
      // Authenticated users can create applications
      allow create: if request.auth != null && 
                       request.data.userId == request.auth.uid &&
                       request.data.submissionType == 'authenticated';
      
      // Guest submissions (no authentication required)
      allow create: if request.data.submissionType == 'guest' &&
                       request.data.guestId != null &&
                       request.data.userId == null;
      
      // Users can read their own applications
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Admins and reviewers can read ALL applications
      allow read: if isAdminOrReviewer();
      
      // Only admins and reviewers can update applications (for status changes)
      allow update: if isAdminOrReviewer();
      
      // Nobody can delete applications
      allow delete: if false;
    }
    
    // Test collection for diagnostics (remove in production)
    match /test/{document} {
      allow read, write: if true;
    }
    
    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}